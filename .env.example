# Copy to .env and fill in. ONE model for all experiments (FIXED).
# Any OpenAI-compatible chat endpoint with tool calling.
# Official run used OpenRouter + openai/gpt-4o-mini; keep these two values to reuse cache/llm (zero API calls).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-...
LLM_MODEL=openai/gpt-4o-mini

# Fixed generation settings
LLM_MAX_TOKENS=256
LLM_SEED=42
LLM_SEND_SEED=1
LLM_TIMEOUT_S=60

# Price per 1M tokens (USD) used for cloud_cost_usd — set to your provider's list price
LLM_PRICE_IN_PER_M=0.15
LLM_PRICE_OUT_PER_M=0.60

# Robustness
MAX_CONCURRENCY=4

# Provider tokens-per-minute cap for pacing (0 = off). Groq free tier: 8000; paid APIs: 0
LLM_TPM_LIMIT=0
